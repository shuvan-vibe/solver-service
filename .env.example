# Self-hosted Turnstile solver service
#
# Copy this file to .env and fill in the values.
# NEVER commit the real .env.

# --- API ---
# Shared secret used by the scanners. Leave empty only for local testing.
SOLVER_API_KEY=change-me-to-a-long-random-string
SOLVER_MAX_RETRIES=2
SOLVER_MAX_WAIT=180

# --- Network ---
# xray = use the VLESS tunnel below (recommended)
# proxy = use PROXY_URL (residential proxy)
# direct = no proxy (testing only)
SOLVER_NETWORK_MODE=xray

# Full VLESS URL (same VPN the proxy scanner uses)
XRAY_VLESS_CONFIG=vless://uuid@host:port?encryption=none&flow=xtls-rprx-vision&security=reality&sni=example.com&fp=random&pbk=PUBLIC_KEY&sid=SHORT_ID&type=tcp#Server

# Optional: use a subscription instead of a full VLESS URL
# XRAY_SUBSCRIPTION_URL=https://provider/api/v1/user/getSubscribe?key=xxx
# XRAY_PREFERRED_SERVER=Europe

# Optional fallback residential proxy
# PROXY_URL=user:pass@host:port

# --- On-demand lifecycle ---
XRAY_IDLE_TIMEOUT=600
BROWSER_IDLE_TIMEOUT=900
BROWSER_MAX_SOLVES=250

# --- Xray ---
# XRAY_VERSION=1.8.7
# XRAY_DIR=/tmp/xray
# XRAY_PROXY_SCHEME=http

# --- MongoDB heartbeat (used by GitHub Actions / bot URL discovery) ---
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGO_DB=socpublic_db
# SOLVER_STATUS_COLLECTION=solver_status
# SOLVER_PUBLIC_URL=https://xxxx.trycloudflare.com

# --- Server ---
# PORT=8080
